{
  "name": "@agent-qofeno/unbuild",
  "version": "1.0.0",
  "description": "Deconstruct a rendered website into evidence-backed UI, UX, design-system, responsive and motion artifacts for AI coding agents.",
  "type": "module",
  "bin": {
    "unbuild": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm run check && npm run build",
    "audit": "npm audit --audit-level=high"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SohailKhan0525/unbuild.git"
  },
  "bugs": {
    "url": "https://github.com/SohailKhan0525/unbuild/issues"
  },
  "homepage": "https://github.com/SohailKhan0525/unbuild#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "website",
    "website-reconstruction",
    "ui-reconstruction",
    "frontend-reconstruction",
    "browser-evidence",
    "website-analysis",
    "website-audit",
    "browser-automation",
    "playwright",
    "design-system",
    "design-tokens",
    "design-audit",
    "design-extraction",
    "design-to-code",
    "reverse-engineering",
    "ui",
    "ux",
    "responsive",
    "motion",
    "ai",
    "ai-agent",
    "ai-coding",
    "coding-agent",
    "claude-code",
    "codex",
    "cursor",
    "gemini",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "@playwright/browser-chromium": "1.63.0",
    "playwright": "1.63.0",
    "@axe-core/playwright": "4.13.0",
    "postcss": "8.5.28"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "6.0.3",
    "semantic-release": "25.0.9",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@semantic-release/npm": "^13.1.2"
  },
  "author": "qofeno-labs"
}
